{
  "name": "deduplication-app-playwright",
  "version": "0.1.0",
  "private": true,
  "devDependencies": {
    "playwright": "^1.40.0",
    "start-server-and-test": "^3.0.0"
  },
  "scripts": {
    "playwright:install-browsers": "npx playwright install --with-deps",
    "start:shiny": "Rscript -e \"shiny::runApp('shiny', port=3456, launch.browser = FALSE)\"",
    "test:playwright": "playwright test",
    "test:playwright:ci": "start-server-and-test 'npm run start:shiny' http://localhost:3456 npm run test:playwright"
  }
}
